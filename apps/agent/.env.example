# apps/agent — environment variables
#
# No real values here. Copy to apps/agent/.env for local dev (gitignored),
# or set these in the Render dashboard (Environment tab) for the deployed
# service. See the root `.env.example` for the full cross-repo picture and
# which slice introduces each var.

# LiveKit Cloud (Slice 1, #2) — required to mint room tokens and connect
# the agent's own participant.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram Nova-3 streaming STT (Slice 2, #3).
DEEPGRAM_API_KEY=

# Groq LLM (Slice 3, #4).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cartesia Sonic TTS + ElevenLabs Flash v2.5 fallback (Slice 4, #5).
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Upstash Redis — barge-in generation tracking (Slice 5, #6) and rate
# limiting (Slice 7, #8).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile secret key — server-side verification only
# (Slice 7, #8). The public site key lives in apps/web's env, not here.
TURNSTILE_SECRET_KEY=

# Neon Postgres connection string — latency_events + transcripts
# (Slice 6, #7 onward).
DATABASE_URL=

# AWS S3 — call recordings, 90-day lifecycle rule (Slice 8, #9).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_RECORDINGS_BUCKET=

# Render sets this automatically at runtime — do not set it yourself.
# PORT=
