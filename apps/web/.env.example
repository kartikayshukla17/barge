# apps/web — environment variables
#
# Only `VITE_`-prefixed vars are readable in the browser bundle — never put
# a secret here. No real values in this file. Copy to apps/web/.env for
# local dev (gitignored), or set these in the Vercel dashboard (Project
# Settings → Environment Variables) for Production/Preview.

# Public base URL of the deployed apps/agent service (Slice 1, #2 onward).
# Local dev default points at an agent running locally.
VITE_AGENT_URL=http://localhost:8080

# Cloudflare Turnstile public site key, gating "start call" (Slice 7, #8).
# Safe to expose — it's the public half of the Turnstile key pair.
VITE_TURNSTILE_SITE_KEY=
