# Barge — environment variables, repo-wide reference
#
# This file documents every environment variable used anywhere in the
# project, across every remaining slice (#2-#9; Slice 10/auth is deferred
# and not listed). It contains NO real values — copy it to `.env` locally
# and fill in real values there (`.env` is gitignored). For deployed
# environments, set these in the relevant dashboard, noted per variable.
#
# More specific examples live alongside each app:
#   apps/agent/.env.example  — backend-only vars (Render dashboard)
#   apps/web/.env.example    — frontend-only `VITE_*` vars (Vercel dashboard)
# This root file is the full picture; the per-app files are the minimal
# subset each app actually reads.

# ── LiveKit Cloud (transport/SFU — Slice 1, #2) ─────────────────────────
# Where: local .env (agent) + Render dashboard (agent, production).
# The project's own WebSocket URL for the LiveKit Cloud project.
LIVEKIT_URL=
# Server API key/secret used by apps/agent to mint room access tokens and
# to connect the echo/orchestration participant. Never exposed to the browser.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Deepgram Nova-3 streaming STT (Slice 2, #3) ─────────────────────────
# Where: local .env (agent) + Render dashboard (agent).
DEEPGRAM_API_KEY=

# ── Groq LLM (Slice 3, #4) ───────────────────────────────────────────────
# Where: local .env (agent) + Render dashboard (agent).
GROQ_API_KEY=
# Model id, verified at build time against Groq's currently-free catalog.
GROQ_MODEL=llama-3.3-70b-versatile

# ── Cartesia Sonic TTS, with ElevenLabs Flash v2.5 fallback (Slice 4, #5) ─
# Where: local .env (agent) + Render dashboard (agent).
CARTESIA_API_KEY=
# Only needed if/when Cartesia's free cap proves too tight and the
# ElevenLabs fallback path is enabled.
ELEVENLABS_API_KEY=

# ── Upstash Redis (barge-in generation tracking + rate limiting; Slices 5
#    and 7, #6 and #8) ────────────────────────────────────────────────────
# Where: local .env (agent) + Render dashboard (agent).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare Turnstile (bot protection gating "start call"; Slice 7, #8) ─
# Site key is public and ships in the frontend bundle.
# Where: local .env (web, as VITE_TURNSTILE_SITE_KEY) + Vercel dashboard.
TURNSTILE_SITE_KEY=
# Secret key is server-side only, used by apps/agent to verify the token.
# Where: local .env (agent) + Render dashboard (agent).
TURNSTILE_SECRET_KEY=

# ── Neon Postgres (latency_events + transcripts; Slice 6, #7 onward) ────
# Where: local .env (agent) + Render dashboard (agent).
DATABASE_URL=

# ── AWS S3 (call recordings; Slice 8, #9) ────────────────────────────────
# Where: local .env (agent) + Render dashboard (agent).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_RECORDINGS_BUCKET=

# ── Render (apps/agent hosting) ──────────────────────────────────────────
# Render sets PORT automatically at runtime — do not set it yourself.
# PORT=

# ── Vercel (apps/web hosting) ─────────────────────────────────────────────
# Public base URL of the deployed apps/agent service, so the browser knows
# where to request a room token from. Where: Vercel dashboard (Production
# + Preview env vars) + local .env (web) for local dev against a running
# agent.
VITE_AGENT_URL=http://localhost:8080

# ── better-auth (Slice 10, #11 — deferred, NOT used in v1) ───────────────
# The dependency is wired into the codebase but has no active login flow.
# Left here only so the var name is known when/if Slice 10 is picked up.
# BETTER_AUTH_SECRET=
